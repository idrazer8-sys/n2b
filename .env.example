# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/restaurant_platform"
# Used for Prisma migrations. With plain Postgres (no pooler in front),
# this can be the same value as DATABASE_URL. On Supabase, this is the
# project's "Session pooler" connection string (port 5432) — NOT the true
# direct-to-database host; see REALTIME_DIRECT_URL below for why that
# distinction matters.
DIRECT_URL="postgresql://user:password@localhost:5432/restaurant_platform"

# --- Realtime (optional — cross-instance order/kitchen/waiter updates) ----
# src/lib/order-events.ts uses an in-process EventEmitter by default, which
# only delivers realtime updates when the publish and the SSE subscriber
# happen to land on the same server instance — fine for local dev or a
# single-instance deploy, not reliable on Vercel (multi-instance) once you
# have more than one restaurant using the dashboard/kitchen/waiter screens
# at once. Setting this activates Postgres LISTEN/NOTIFY as well, which
# works across instances.
#
# This MUST be a genuine non-pooled Postgres connection — verified during
# this hardening pass that Supabase's pooler (both DATABASE_URL's
# transaction mode and DIRECT_URL's session mode above) does NOT relay
# NOTIFY between different pooled connections (LISTEN "succeeds" with no
# error, but nothing ever arrives). On Supabase specifically, the real
# direct host (Project Settings -> Database -> "Direct connection") is
# IPv6-only, and Vercel's serverless functions don't support outbound
# IPv6 — reaching it from a Vercel deploy requires Supabase's paid IPv4
# add-on. Without that (or a different Postgres host with real IPv4 direct
# access), leave this unset — the app works fine, just without
# cross-instance realtime, exactly as it did before this variable existed.
REALTIME_DIRECT_URL=""

# --- Auth (staff dashboard sessions) -------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Customer session cookie ---------------------------------------------
# Generate with: openssl rand -base64 32
CUSTOMER_SESSION_SECRET="replace-with-a-different-long-random-string"

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Membership billing (Stripe Subscriptions) ----------------------------
# Stripe Price IDs for each tier's monthly + annual plan. Create these with
# `npx tsx scripts/setup-stripe-products.ts` (test mode) and paste the
# printed IDs here.
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_BASIC_ANNUAL="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_PRO_ANNUAL="price_..."
STRIPE_PRICE_BUSINESS="price_..."
STRIPE_PRICE_BUSINESS_ANNUAL="price_..."

# --- App --------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI features (menu import from photos, manager support chat) --------
# Free Google Gemini API key (from https://aistudio.google.com/apikey).
# Without it, both features return a clear "not configured" error instead
# of crashing.
GEMINI_API_KEY="AIzaSy..."
# Optional override; defaults to a Gemini model with a free usage tier.
AI_MODEL="gemini-2.0-flash"

# Optional: a Slack/Discord "incoming webhook" URL (or any endpoint that
# accepts { "text": "..." }). When a manager's support chat gets escalated,
# a short notification is POSTed here so your team can follow up. Safe to
# leave unset — escalations are still saved and visible at /admin/support.
SUPPORT_ESCALATION_WEBHOOK_URL=""

# Comma-separated list of emails allowed to view /admin/support (the
# cross-restaurant support inbox). These must be emails of existing
# accounts (any RestaurantStaff or plain registered user works, since the
# check is just "is this the logged-in user's email").
PLATFORM_ADMIN_EMAILS="owner@testrestaurant.com"

# --- Error tracking (Sentry) ----------------------------------------------
# Optional but strongly recommended before real launch — without these, the
# app runs exactly the same, it just has no visibility into production
# crashes (the Sentry SDK is a safe no-op when DSN is unset). Create a free
# project at https://sentry.io, choose "Next.js", and it'll give you both
# DSNs below (usually the same value for both).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Optional — only needed to upload source maps at build time so stack
# traces in Sentry show your actual source instead of minified bundles.
# From Sentry: Settings -> Auth Tokens (needs project:releases scope).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
