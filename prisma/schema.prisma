generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String            @id @default(cuid())
  email                    String            @unique
  passwordHash             String
  name                     String
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  orderEvents              OrderEvent[]
  staffMemberships         RestaurantStaff[]
  confirmedSessionPayments SessionPayment[]  @relation("SessionPaymentConfirmedBy")
  confirmedPayments        Payment[]         @relation("PaymentConfirmedBy")
  createdReservations      Reservation[]     @relation("ReservationCreatedBy")
}

model RestaurantStaff {
  id                                                          String            @id @default(cuid())
  userId                                                      String
  restaurantId                                                String
  role                                                        StaffRole         @default(STAFF)
  staffPortal                                                 StaffPortal       @default(WAITER)
  isActive                                                    Boolean           @default(true)
  deletedAt                                                   DateTime?
  createdAt                                                   DateTime          @default(now())
  Order                                                       Order[]
  restaurant                                                  Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user                                                        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  TableAssignment_TableAssignment_assignedByToRestaurantStaff TableAssignment[] @relation("TableAssignment_assignedByToRestaurantStaff")
  TableAssignment_TableAssignment_staffIdToRestaurantStaff    TableAssignment[] @relation("TableAssignment_staffIdToRestaurantStaff")
  SupportConversation                                          SupportConversation[]

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
}

// Backs src/lib/rate-limit.ts. A plain in-memory Map can't rate-limit
// anything meaningfully on Vercel — each request may land on a different,
// cold serverless instance with its own empty Map, so a brute-force login
// or order-spam attempt effectively never accumulates a shared count. This
// table gives the limiter real cross-instance shared state via a single
// atomic INSERT ... ON CONFLICT per check (see rateLimit()).
model RateLimitBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

model Restaurant {
  id                     String            @id @default(cuid())
  slug                   String            @unique
  name                   String
  description            String?
  logoUrl                String?
  coverUrl               String?
  address                String?
  phone                  String?
  currency               String            @default("EUR")
  timezone               String            @default("Europe/Madrid")
  openingHours           Json?
  brandPrimaryColor      String            @default("#111111")
  isOpen                 Boolean           @default(true)
  isActive               Boolean           @default(true)
  allowPayAtRestaurant   Boolean           @default(true)
  reservationBufferMinutes Int             @default(15)
  // Atomically incremented to hand out the next order number per
  // restaurant. Reading MAX(orderNumber)+1 at request time raced under
  // concurrent orders (two requests could read the same max before either
  // committed) and threw a unique constraint error, dropping the order.
  nextOrderNumber        Int               @default(1001)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  googleReviewUrl        String?
  kitchenSlaSeconds      Int?
  totalServiceSlaSeconds Int?
  waiterSlaSeconds       Int?
  acceptanceSlaSeconds   Int?
  categories             MenuCategory[]
  items                  MenuItem[]
  orders                 Order[]
  orderEvents            OrderEvent[]
  staff                  RestaurantStaff[]
  stripeAccount          StripeAccount?
  membership             Membership?
  tables                 Table[]
  TableAssignment        TableAssignment[]
  SupportConversation    SupportConversation[]
  tableZones             TableZone[]
  reservations           Reservation[]
  cashDenominations      CashDenomination[]

  @@index([slug])
}

model Membership {
  id                   String            @id @default(cuid())
  restaurantId         String            @unique
  tier                 MembershipTier?
  status               MembershipStatus  @default(INCOMPLETE)
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  stripePriceId        String?
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  restaurant           Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

enum MembershipTier {
  BASIC
  PRO
  BUSINESS
}

enum MembershipStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Table {
  id              String             @id @default(cuid())
  restaurantId    String
  label           String
  token           String             @unique @default(cuid())
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  zoneId          String?
  x               Int?
  y               Int?
  width           Int?               @default(88)
  height          Int?               @default(88)
  shape           TableShape         @default(SQUARE)
  orders          Order[]
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zone            TableZone?         @relation(fields: [zoneId], references: [id])
  TableAssignment TableAssignment[]
  reservations    Reservation[]

  @@index([restaurantId])
  @@index([token])
  @@index([zoneId])
}

model MenuCategory {
  id                String           @id @default(cuid())
  restaurantId      String
  name              String
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  isDessertCategory Boolean          @default(false)
  kitchenKind       MenuCategoryKind @default(FOOD)
  // Optional convenience default: new items created in this category start
  // with this VAT rate pre-filled (still editable per item — see
  // MenuItem.vatRateBps for why the per-item value is what's authoritative).
  // Null means no category-level default has been set.
  defaultVatRateBps Int?
  restaurant        Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items             MenuItem[]

  @@index([restaurantId])
}

// What kind of thing this category holds, from the kitchen's point of
// view. DRINKS need no preparation, so kitchen can send a drinks-only
// order straight to the waiter instead of walking it through
// Accept -> Preparing -> Ready.
enum MenuCategoryKind {
  FOOD
  DRINKS
  DESSERT
}

model MenuItem {
  id           String         @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  priceCents   Int
  imageUrl     String?
  allergens    String[]       @default([])
  ingredients  String[]       @default([])
  isAvailable  Boolean        @default(true)
  sortOrder    Int            @default(0)
  // Basis points (1000 = 10.00%), not an enum — VAT classification depends
  // on what the specific item legally is (e.g. Spain's reduced 10% for
  // hostelry food/drink service vs. 21% general rate for certain other
  // products/services), which only the restaurant or their accountant can
  // correctly determine. Defaults to 1000 (10%, Spain's hostelry rate) as a
  // reasonable starting point — never silently guessed beyond that default,
  // and always editable per item.
  vatRateBps   Int            @default(1000)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  category     MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers    MenuModifier[]
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

model MenuModifier {
  id            String                @id @default(cuid())
  menuItemId    String
  name          String
  selectionType ModifierSelectionType @default(SINGLE)
  isRequired    Boolean               @default(false)
  minSelect     Int                   @default(0)
  maxSelect     Int?
  sortOrder     Int                   @default(0)
  menuItem      MenuItem              @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options       MenuModifierOption[]

  @@index([menuItemId])
}

model MenuModifierOption {
  id               String              @id @default(cuid())
  modifierId       String
  name             String
  priceDeltaCents  Int                 @default(0)
  isAvailable      Boolean             @default(true)
  sortOrder        Int                 @default(0)
  modifier         MenuModifier        @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  orderItemChoices OrderItemModifier[]

  @@index([modifierId])
}

model CustomerSession {
  id             String          @id @default(cuid())
  restaurantId   String
  tableId        String
  partySize      Int?
  createdAt      DateTime        @default(now())
  expiresAt      DateTime
  finalizedAt    DateTime?
  paidAt         DateTime?
  orders         Order[]
  sessionPayment SessionPayment?

  @@index([restaurantId, tableId])
}

model Order {
  id                String           @id @default(cuid())
  restaurantId      String
  tableId           String
  customerSessionId String
  orderNumber       Int
  status            OrderStatus      @default(PENDING_PAYMENT)
  notes             String?
  subtotalCents     Int
  taxCents          Int
  totalCents        Int
  currency          String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  acceptedAt        DateTime?
  readyAt           DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  paidAt            DateTime?
  preparingAt       DateTime?
  rejectedAt        DateTime?
  staffId           String?
  customerSession   CustomerSession  @relation(fields: [customerSessionId], references: [id])
  restaurant        Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  RestaurantStaff   RestaurantStaff? @relation(fields: [staffId], references: [id])
  table             Table             @relation(fields: [tableId], references: [id])
  events            OrderEvent[]
  items             OrderItem[]
  payment           Payment?

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, status, createdAt])
  @@index([tableId])
  @@index([customerSessionId])
  @@index([restaurantId, staffId])
}

model OrderItem {
  id              String              @id @default(cuid())
  orderId         String
  menuItemId      String
  nameSnapshot    String
  unitPriceCents  Int
  quantity        Int
  lineTotalCents  Int
  // Snapshot of MenuItem.vatRateBps at the moment this line was ordered —
  // same reasoning as nameSnapshot/unitPriceCents: a rate change to the
  // menu item later must never alter a historical order's figures.
  // NULL specifically means "this order predates VAT tracking" (added in
  // the add_menu_item_vat_rate migration) — reporting must show those
  // periods as "VAT not tracked" rather than fabricating a rate for them;
  // it is never a stand-in for a legitimate 0% rate, which is stored as
  // the literal integer 0.
  vatRateBpsSnapshot Int?
  notes           String?
  status          OrderItemStatus     @default(PENDING)
  sentToWaiterAt  DateTime?
  servedAt        DateTime?
  unavailableAt   DateTime?
  unavailableNote String?
  menuItem        MenuItem            @relation(fields: [menuItemId], references: [id])
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modifiers       OrderItemModifier[]

  @@index([orderId])
}

enum OrderItemStatus {
  PENDING
  SENT_TO_WAITER
  SERVED
  UNAVAILABLE
}

model OrderItemModifier {
  id                      String             @id @default(cuid())
  orderItemId             String
  modifierOptionId        String
  nameSnapshot            String
  priceDeltaCentsSnapshot Int
  modifierOption          MenuModifierOption @relation(fields: [modifierOptionId], references: [id])
  orderItem               OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model OrderEvent {
  id           String         @id @default(cuid())
  orderId      String
  restaurantId String
  type         OrderEventType
  actorUserId  String?
  createdAt    DateTime       @default(now())
  metadata     Json?
  actor        User?          @relation(fields: [actorUserId], references: [id])
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, type, createdAt])
  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
}

model SessionPayment {
  id                      String                   @id @default(cuid())
  customerSessionId       String                   @unique
  stripeCheckoutSessionId String?                  @unique
  stripePaymentIntentId   String?                  @unique
  status                  SessionPaymentStatus     @default(REQUIRES_PAYMENT)
  paymentMethod           PaymentMethod            @default(ONLINE)
  collectionMethod        PaymentCollectionMethod?
  isSplit                 Boolean                  @default(false)
  cashTenderedCents       Int?
  amountCents             Int
  currency                String
  applicationFeeCents     Int
  paidAt                  DateTime?
  confirmedByUserId       String?
  confirmedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  customerSession         CustomerSession          @relation(fields: [customerSessionId], references: [id], onDelete: Cascade)
  confirmedBy             User?                    @relation("SessionPaymentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  splits                  SessionPaymentSplit[]

  @@index([customerSessionId])
  @@index([confirmedByUserId])
}

model Payment {
  id                      String                   @id @default(cuid())
  orderId                 String                   @unique
  stripeCheckoutSessionId String?                  @unique
  stripePaymentIntentId   String?                  @unique
  status                  PaymentStatus            @default(REQUIRES_PAYMENT)
  paymentMethod           PaymentMethod            @default(ONLINE)
  collectionMethod        PaymentCollectionMethod?
  amountCents             Int
  currency                String
  applicationFeeCents     Int
  confirmedByUserId       String?
  confirmedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  order                   Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  confirmedBy             User?                    @relation("PaymentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([confirmedByUserId])
}

model StripeAccount {
  id                 String     @id @default(cuid())
  restaurantId       String     @unique
  stripeAccountId    String     @unique
  onboardingComplete Boolean    @default(false)
  chargesEnabled     Boolean    @default(false)
  payoutsEnabled     Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now())
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model TableAssignment {
  id                                                          String          @id @default(cuid())
  restaurantId                                                String
  tableId                                                     String
  staffId                                                     String
  role                                                        AssignmentRole  @default(PRIMARY)
  assignedAt                                                  DateTime        @default(now())
  endedAt                                                     DateTime?
  assignedBy                                                  String
  shiftId                                                     String?
  RestaurantStaff_TableAssignment_assignedByToRestaurantStaff RestaurantStaff @relation("TableAssignment_assignedByToRestaurantStaff", fields: [assignedBy], references: [id])
  Restaurant                                                  Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  RestaurantStaff_TableAssignment_staffIdToRestaurantStaff    RestaurantStaff @relation("TableAssignment_staffIdToRestaurantStaff", fields: [staffId], references: [id], onDelete: Cascade)
  Table                                                       Table           @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId, staffId, endedAt])
  @@index([restaurantId, tableId, endedAt])
}

enum StaffRole {
  OWNER
  MANAGER
  STAFF
}

enum StaffPortal {
  WAITER
  KITCHEN
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

enum OrderStatus {
  PENDING_PAYMENT
  NEW
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  REJECTED
  CANCELLED
  PAYMENT_FAILED
}

enum OrderEventType {
  ORDER_CREATED
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_PREPARING
  ORDER_READY
  ORDER_COMPLETED
  ORDER_CANCELLED
  ORDER_CLAIMED
  ITEM_SERVED
  ITEM_SENT_TO_WAITER
  ITEM_UNAVAILABLE
  PAYMENT_STARTED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
}

enum SessionPaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum AssignmentRole {
  PRIMARY
  ASSISTING
}

enum PaymentMethod {
  ONLINE
  PAY_AT_RESTAURANT
}

enum PaymentCollectionMethod {
  CASH
  CARD
  OTHER
}

model SupportConversation {
  id           String               @id @default(cuid())
  restaurantId String
  staffId      String
  status       SupportStatus        @default(OPEN)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staff        RestaurantStaff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  messages     SupportMessage[]

  @@index([restaurantId, status])
  @@index([staffId])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  role           SupportMessageRole
  content        String
  createdAt      DateTime            @default(now())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum SupportStatus {
  OPEN
  ESCALATED
  RESOLVED
}

enum SupportMessageRole {
  USER
  ASSISTANT
  HUMAN
}

model TableZone {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  x            Int        @default(0)
  y            Int        @default(0)
  width        Int        @default(260)
  height       Int        @default(220)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables       Table[]

  @@index([restaurantId])
}

enum TableShape {
  SQUARE
  RECT
  CIRCLE
}

model Reservation {
  id           String @id @default(cuid())
  restaurantId String
  tableId      String
  startsAt     DateTime
  // Snapshot of the restaurant's reservationBufferMinutes at the time this
  // reservation was created/edited. The application-level conflict check in
  // findConflictingReservation() reads the restaurant's *current* setting,
  // but the hard guarantee is the DB-level EXCLUDE constraint added in the
  // add_reservation_exclusion_constraint migration, which needs a real
  // column (a per-row value, not the restaurant's live config) to build its
  // overlap range from.
  bufferMinutesSnapshot Int               @default(15)
  partySize             Int
  customerName          String?
  customerPhone         String?
  notes                 String?
  status                ReservationStatus @default(CONFIRMED)
  createdByUserId       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  restaurant            Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table                 Table             @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdBy             User?             @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([tableId])
  @@index([restaurantId, startsAt])
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model CashDenomination {
  id           String     @id @default(cuid())
  restaurantId String
  valueCents   Int
  quantity     Int        @default(0)
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, valueCents])
  @@index([restaurantId])
}

model SessionPaymentSplit {
  id               String         @id @default(cuid())
  sessionPaymentId String
  personIndex      Int
  label            String?
  shareCents       Int
  tenderedCents    Int?
  createdAt        DateTime       @default(now())
  sessionPayment   SessionPayment @relation(fields: [sessionPaymentId], references: [id], onDelete: Cascade)

  @@unique([sessionPaymentId, personIndex])
  @@index([sessionPaymentId])
}
